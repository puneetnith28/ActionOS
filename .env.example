# ==========================================
# ActionOS Local Development Environment
# ==========================================
# Copy this file to .env and fill in the values.
# See docs/ENVIRONMENT.md for detailed explanations of each variable.

# 1. Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1
FIRESTORE_DATABASE=(default)

# 2. Cloud Tasks Configuration (For Background Execution)
CLOUD_TASKS_LOCATION=us-central1
CLOUD_TASKS_QUEUE=actionos-missions
CLOUD_TASKS_SERVICE_ACCOUNT=your-service-account@your-project-id.iam.gserviceaccount.com

# 3. Internal Routing (Localhost or Ngrok for local testing)
APP_BASE_URL=http://localhost:3000
ACTIONOS_PUBLIC_BASE_URL=http://localhost:3000
ACTIONOS_WORKER_URL=http://localhost:3000/api/internal/tasks/run-mission
ACTIONOS_ANALYSIS_WORKER_URL=http://localhost:3000/api/internal/tasks/analyze-case
ACTIONOS_ARTIFACT_BUCKET=your-artifact-bucket-name

# 4. Managed Email Capability (Resend)
RESEND_API_KEY=re_your_api_key_here
COMPANY_EMAIL_FROM=agent@actionos.dev
COMPANY_EMAIL_REPLY_DOMAIN=reply.actionos.dev
EMAIL_WEBHOOK_SIGNING_SECRET=whsec_your_webhook_secret
COMPANY_EMAIL_ALLOWED_RECIPIENT_DOMAINS=example.com,test.com
ACTIONOS_NOTIFICATION_FROM=notifications@actionos.dev

# 5. Merchant Sandbox Capability
MERCHANT_SANDBOX_URL=http://localhost:3000/api/sandbox
MERCHANT_CALLBACK_SECRET=generate_a_random_secret_string_here
MERCHANT_SANDBOX_RECIPIENT=usr_sandbox_test_123

# 6. Partner API Integrations
PARTNER_FIXTURE_ENDPOINT=https://api.example.com/v1/trigger
PARTNER_FIXTURE_SIGNING_SECRET=ptnr_sec_your_secret_here

# 7. Firebase Client Configuration (Safe for frontend)
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=1:1234567890:web:abcdef123456
